{
  "name": "@seen/ios",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev:simulator": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --port 8082 --localhost",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios",
    "export:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@react-native/metro-config": "0.86.3",
    "@seen/contracts": "workspace:*",
    "@seen/domain": "workspace:*",
    "@seen/fixtures": "workspace:*",
    "expo": "57.0.26",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.20",
    "expo-dev-client": "57.0.19",
    "expo-haptics": "57.0.3",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-sqlite": "57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "19.2.16"
  }
}
