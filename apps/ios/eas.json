{
  "cli": { "version": ">=18.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" }
    },
    "simulator": { "extends": "development", "ios": { "simulator": true } },
    "staging": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "staging" }
    },
    "production": { "env": { "APP_VARIANT": "production" }, "autoIncrement": true }
  }
}
