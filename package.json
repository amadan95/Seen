{
  "name": "seen-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @seen/ios start",
    "dev:simulator": "pnpm --filter @seen/ios dev:simulator",
    "ios": "pnpm --filter @seen/ios ios",
    "web": "pnpm --filter @seen/ios web",
    "catalog:dev": "node --import tsx scripts/catalog-dev.ts",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "edge:bundle": "node scripts/bundle-edge.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@seen/catalog": "workspace:*",
    "@seen/contracts": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "prettier": "3.7.4",
    "supabase": "2.119.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
